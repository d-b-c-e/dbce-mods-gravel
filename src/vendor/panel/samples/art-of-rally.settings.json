{
  "settings": {
    "product": "Art of Rally Wheel Mod",
    "version": "0.4.4",
    "modPage": "https://github.com/d-b-c-e/dbce-mods-art-of-rally",
    "pages": {
      "controls": [
        { "id": "controls.status", "kind": "status", "text": "Set up your wheel: click Steering." },
        { "id": "controls.steering", "kind": "binding", "label": "Steering", "help": "Turn the wheel fully left, then right." },
        { "id": "controls.throttle", "kind": "binding", "label": "Throttle", "help": "Press the throttle all the way, then release." },
        { "id": "controls.brake", "kind": "binding", "label": "Brake", "help": "Press the brake all the way, then release." },
        { "id": "controls.shift-up", "kind": "binding", "label": "Shift up", "help": "Press the paddle or button for shifting up." },
        { "id": "controls.shift-down", "kind": "binding", "label": "Shift down", "help": "Press the paddle or button for shifting down." },
        { "id": "controls.handbrake", "kind": "binding", "label": "Handbrake", "level": "advanced" },
        { "id": "controls.clutch", "kind": "binding", "label": "Clutch", "level": "advanced" },
        { "id": "controls.gearbox", "kind": "choice", "label": "Gearbox", "level": "advanced",
          "choices": ["Game setting", "Automatic", "Manual"], "default": "Game setting",
          "help": "Overrides the game's own gearbox setting." },
        { "id": "controls.change-camera", "kind": "binding", "label": "Change camera", "level": "advanced" },
        { "id": "controls.look-back", "kind": "binding", "label": "Look back", "level": "advanced" },
        { "id": "controls.recover", "kind": "binding", "label": "Recover car", "level": "advanced" },
        { "id": "controls.restart-stage", "kind": "binding", "label": "Restart stage", "level": "advanced" },
        { "id": "controls.horn", "kind": "binding", "label": "Horn", "level": "advanced" },
        { "id": "controls.menu-pause", "kind": "binding", "label": "Pause", "level": "advanced" },
        { "id": "controls.menu-confirm", "kind": "binding", "label": "Confirm", "level": "advanced" },
        { "id": "controls.menu-back", "kind": "binding", "label": "Back", "level": "advanced" },
        { "id": "controls.open-settings", "kind": "binding", "label": "Open settings (F6)", "level": "advanced", "text": "Keyboard · F6" },
        { "id": "controls.ffb-off", "kind": "binding", "label": "Force feedback off (F8)", "level": "advanced", "text": "Keyboard · F8" },
        { "id": "controls.restore", "kind": "action", "label": "Restore defaults", "level": "advanced",
          "help": "Clears your bindings on this page." },
        { "id": "controls.direct-steering", "kind": "toggle", "label": "Direct steering", "default": true, "level": "developer" },
        { "id": "controls.zero-deadzone", "kind": "toggle", "label": "Remove hidden deadzone", "default": true, "level": "developer" },
        { "id": "controls.steer-assist-override", "kind": "toggle", "label": "Legacy steering limiter override", "level": "developer" }
      ],
      "ffb": [
        { "id": "ffb.status", "kind": "status", "text": "Starts when you drive" },
        { "id": "ffb.enabled", "kind": "toggle", "label": "Force feedback", "default": true, "help": "F8 turns it off at any time." },
        { "id": "ffb.strength", "kind": "percent", "label": "Strength", "default": 50,
          "help": "How heavy the wheel feels. Lower it for strong wheels." },
        { "id": "ffb.crash", "kind": "percent", "label": "Crash strength", "default": 50, "level": "advanced",
          "help": "How hard crashes and big bumps hit." },
        { "id": "ffb.reverse", "kind": "toggle", "label": "Reverse direction", "level": "advanced",
          "help": "Turn on if the wheel pulls away from center." },
        { "id": "ffb.device", "kind": "choice", "label": "Wheel", "level": "advanced",
          "choices": ["Same as steering", "Second force feedback device"], "help": "Which device gives force feedback." },
        { "id": "ffb.restore", "kind": "action", "label": "Restore defaults", "level": "advanced" },
        { "id": "ffb.smoothing", "kind": "slider", "label": "Smoothing", "unit": "%", "min": 0, "max": 95, "default": 20, "level": "developer" },
        { "id": "ffb.landing", "kind": "slider", "label": "Landing strength", "unit": "%", "min": 0, "max": 40, "default": 5, "level": "developer" },
        { "id": "ffb.shift", "kind": "slider", "label": "Shift strength", "unit": "%", "min": 0, "max": 20, "default": 5, "level": "developer" }
      ],
      "display": [
        { "id": "display.screens", "kind": "choice", "label": "Screens", "apply": "next-start",
          "choices": ["Off", "Surround", "Separate monitors"], "default": "Off",
