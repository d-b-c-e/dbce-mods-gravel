        { "id": "display.eye-distance", "kind": "number", "label": "Eye distance", "unit": "cm", "min": 30, "max": 300,
          "default": 60, "help": "From your eyes to the center screen, level with its edges." },
        { "id": "display.screen-size", "kind": "number", "label": "Screen size", "unit": "in", "min": 10, "max": 100,
          "default": 27, "decimals": 1, "level": "advanced", "help": "Diagonal size of one screen." },
        { "id": "display.side-angle", "kind": "slider", "label": "Side angle", "unit": "°", "min": 0, "max": 89, "default": 45,
          "level": "advanced", "help": "How far the side screens turn toward you." },
        { "id": "display.bezel-gap", "kind": "number", "label": "Bezel gap", "unit": "mm", "min": 0, "max": 100, "default": 8,
          "level": "advanced", "help": "The gap between pictures where two screens meet." },
        { "id": "display.curve", "kind": "choice", "label": "Curved screens", "level": "advanced",
          "choices": ["Flat", "1000R", "1500R", "1800R", "2300R", "3800R"], "default": "Flat",
          "help": "The R number on curved monitors, such as 1500R." },
        { "id": "display.center-menus", "kind": "toggle", "label": "Menus on the middle screen", "level": "advanced",
          "help": "Keeps menus and the HUD on the center screen." },
        { "id": "display.restore", "kind": "action", "label": "Restore defaults", "level": "advanced" },
        { "id": "display.allow-mismatch", "kind": "toggle", "label": "Allow output resolution mismatch", "level": "developer" }
      ],
      "cameras": [
        { "id": "cameras.view", "kind": "status", "text": "Drive to adjust the current camera." },
        { "id": "cameras.hint", "kind": "status", "text": "Numpad moves the camera, + and - zoom, 5 resets." },
        { "id": "cameras.switch", "kind": "action", "label": "Switch view (F7)" },
        { "id": "cameras.bonnet", "kind": "toggle", "label": "Bonnet camera", "default": true, "level": "advanced",
          "help": "Adds a hood view to the game's camera cycle." },
        { "id": "cameras.bumper", "kind": "toggle", "label": "Bumper camera", "default": true, "level": "advanced",
          "help": "Adds a bumper view to the game's camera cycle." },
        { "id": "cameras.fov", "kind": "slider", "label": "Field of view", "unit": "°", "min": 20, "max": 120, "default": 60,
          "level": "advanced", "help": "Zoom for the current camera." },
        { "id": "cameras.reset", "kind": "action", "label": "Reset camera", "level": "advanced",
          "help": "Puts the current camera back to its starting view." },
        { "id": "cameras.keys", "kind": "toggle", "label": "Camera keys", "default": true, "level": "advanced" },
        { "id": "cameras.lean", "kind": "percent", "label": "Corner lean", "default": 10, "level": "developer" },
        { "id": "cameras.move-step", "kind": "number", "label": "Move per press", "unit": "cm", "min": 0.5, "max": 25,
          "default": 2, "decimals": 1, "level": "developer" }
      ],
      "telemetry": [
        { "id": "telemetry.status", "kind": "status", "text": "Sending · in SimHub choose Forza Horizon 5" },
        { "id": "telemetry.enabled", "kind": "toggle", "label": "Telemetry", "default": true,
          "help": "Live car data for dashboard apps such as SimHub." },
        { "id": "telemetry.port", "kind": "number", "label": "Port", "min": 1, "max": 65535, "default": 8000, "level": "advanced",
          "help": "Change only if your dashboard app uses another port." },
        { "id": "telemetry.restore", "kind": "action", "label": "Restore defaults", "level": "advanced" }
      ],
      "help": [
        { "id": "help.report", "kind": "action", "label": "Report a problem",
          "help": "Saves a report on your Desktop and opens the mod's page." },
        { "id": "help.restore-all", "kind": "action", "label": "Restore all defaults", "level": "advanced",
          "help": "Every setting returns to its default. Bindings are kept." },
        { "id": "help.diagnostic-log", "kind": "toggle", "label": "Log detail for support", "level": "developer" }
      ]
    }
  }
}
